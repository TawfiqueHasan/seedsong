{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm view *)",
      "Bash(npm create vite@latest *)",
      "Bash(npm ls *)",
      "Bash(npx playwright *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx prettier *)",
      "Bash(npx oxlint *)",
      "Bash(node scripts/*)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git stash *)",
      "Bash(git tag *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "mcp__playwright",
      "mcp__context7"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf ai-logs*)",
      "Bash(rm -rf .claude*)",
      "Edit(ai-logs/**)",
      "Write(ai-logs/**)",
      "Edit(.claude/hooks/**)",
      "Write(.claude/hooks/**)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ai-log.mjs", "prompt"],
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ai-log.mjs", "stop"],
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ai-log.mjs", "subagent-stop"],
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ai-log.mjs", "session-end"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
